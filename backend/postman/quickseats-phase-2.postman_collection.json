{
  "info": {
    "_postman_id": "bcab8c06-9313-49ad-9a7e-17a7902d11e2",
    "name": "QuickSeats",
    "description": "QuickSeats backend collection for authentication, events, seat locking, and Stripe test-mode payments.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Register success', function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) { pm.environment.set('userId', pm.response.json().data._id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Ali Khan\",\n  \"email\": \"ali@example.com\",\n  \"password\": \"StrongPassword123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login success', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) { pm.environment.set('accessToken', pm.response.json().data.token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ali@example.com\",\n  \"password\": \"StrongPassword123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/auth/me"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Authorization",
      "item": [
        {
          "name": "Access as USER",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/auth/me"
          }
        },
        {
          "name": "Access as ORGANIZER",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Organizer Access Test\",\n  \"description\": \"Used to test organizer-only access\",\n  \"category\": \"music\",\n  \"venueId\": \"{{venueId}}\",\n  \"organizerId\": \"{{userId}}\",\n  \"startDate\": \"2030-07-01T18:00:00.000Z\",\n  \"endDate\": \"2030-07-01T21:00:00.000Z\"\n}"
            },
            "url": "{{baseUrl}}/api/events"
          }
        },
        {
          "name": "Access as ADMIN",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/auth/me"
          }
        }
      ]
    },
    {
      "name": "Venues",
      "item": [
        {
          "name": "Create venue",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Venue created', function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) { pm.environment.set('venueId', pm.response.json().data._id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"QuickSeats Sample Hall\",\n  \"description\": \"A sample venue for API testing\",\n  \"address\": {\n    \"street\": \"1 Main Street\",\n    \"city\": \"Seattle\",\n    \"state\": \"Washington\",\n    \"country\": \"United States\",\n    \"postalCode\": \"98101\"\n  },\n  \"capacity\": 60,\n  \"sections\": [\n    { \"name\": \"A\", \"rows\": 5, \"seatsPerRow\": 10, \"seatCategory\": \"STANDARD\", \"price\": 1500 },\n    { \"name\": \"VIP\", \"rows\": 2, \"seatsPerRow\": 5, \"seatCategory\": \"VIP\", \"price\": 3500 }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/venues"
          }
        },
        {
          "name": "List venues",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/venues?page=1&limit=20&search=Hall&city=Seattle&sortBy=name&order=asc"
          }
        },
        {
          "name": "Get venue",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/venues/{{venueId}}"
          }
        },
        {
          "name": "Update venue",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Updated sample venue\"\n}"
            },
            "url": "{{baseUrl}}/api/venues/{{venueId}}"
          }
        },
        {
          "name": "Delete venue (conflicts when events exist)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/venues/{{venueId}}"
          }
        }
      ]
    },
    {
      "name": "Events",
      "item": [
        {
          "name": "Create event",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Event created as draft', function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) { pm.environment.set('eventId', pm.response.json().data._id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"QuickSeats Sample Concert\",\n  \"description\": \"A sample event for API testing\",\n  \"category\": \"music\",\n  \"venueId\": \"{{venueId}}\",\n  \"organizerId\": \"{{userId}}\",\n  \"startDate\": \"2030-06-01T18:00:00.000Z\",\n  \"endDate\": \"2030-06-01T21:00:00.000Z\"\n}"
            },
            "url": "{{baseUrl}}/api/events"
          }
        },
        {
          "name": "List published events",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/events?page=1&limit=20&search=Concert&category=music&city=Seattle&sortBy=startDate&order=asc"
          }
        },
        {
          "name": "Get event",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/events/{{eventId}}"
          }
        },
        {
          "name": "Update event (publish)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PUBLISHED\"\n}"
            },
            "url": "{{baseUrl}}/api/events/{{eventId}}"
          }
        },
        {
          "name": "Delete event (conflicts when seats or bookings exist)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/events/{{eventId}}"
          }
        }
      ]
    },
    {
      "name": "Seat Generation",
      "item": [
        {
          "name": "Generate event seats",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Seats generated', function () { pm.response.to.have.status(200); });",
                  "pm.test('Generation summary returned', function () { if (pm.response.code === 200) { pm.expect(pm.response.json().data).to.have.property('totalSeats'); } });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/events/{{eventId}}/generate-seats"
          }
        },
        {
          "name": "Generate seats again (expect 409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Duplicate generation is rejected', function () { pm.response.to.have.status(409); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/events/{{eventId}}/generate-seats"
          }
        }
      ]
    },
    {
      "name": "Seat Map",
      "item": [
        {
          "name": "Get paginated seat map",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const seat = pm.response.json().data.seats.find(function (item) { return item.status === 'AVAILABLE'; });",
                  "  if (seat) { pm.environment.set('seatId', seat.id); }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/events/{{eventId}}/seats?page=1&limit=100"
          }
        },
        {
          "name": "Filter seat map by section",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/events/{{eventId}}/seats?page=1&limit=100&section=A"
          }
        },
        {
          "name": "Filter seat map by category",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/events/{{eventId}}/seats?page=1&limit=100&category=VIP"
          }
        }
      ]
    },
    {
      "name": "Seat Locking",
      "item": [
        {
          "name": "Hold Seats",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Seat hold created', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) { pm.environment.set('holdId', pm.response.json().data.holdId); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"seatIds\": [\"{{seatId}}\"]\n}"
            },
            "url": "{{baseUrl}}/api/events/{{eventId}}/seats/hold"
          }
        },
        {
          "name": "Release Hold",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"holdId\": \"{{holdId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/events/{{eventId}}/seats/release"
          }
        }
      ]
    },
    {
      "name": "Payments",
      "description": "Set eventId and holdId after holding seats. Stripe Checkout is test-mode only.",
      "item": [
        {
          "name": "Create Checkout Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Checkout session created', function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) { pm.environment.set('bookingId', pm.response.json().data.bookingId); pm.environment.set('checkoutUrl', pm.response.json().data.checkoutUrl); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"holdId\": \"{{holdId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/bookings/checkout"
          }
        },
        {
          "name": "Get Booking",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/bookings/{{bookingId}}"
          }
        },
        {
          "name": "Get My Bookings",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/bookings/my?page=1&limit=20"
          }
        },
        {
          "name": "Get Booking Status",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/bookings/{{bookingId}}/status"
          }
        }
      ]
    },
    {
      "name": "Webhook Testing",
      "description": "For valid and duplicate webhook deliveries, use Stripe CLI: stripe listen --forward-to {{baseUrl}}/api/payments/webhook. Resend a delivered event with stripe events resend <event_id>.",
      "item": [
        {
          "name": "Valid Stripe Webhook (Stripe CLI)",
          "description": "A valid Stripe-Signature is generated by Stripe CLI. Do not copy a live secret into Postman.",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Stripe-Signature", "value": "{{stripeSignature}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"evt_test_replace_with_cli_event_id\",\n  \"object\": \"event\",\n  \"type\": \"checkout.session.completed\",\n  \"data\": { \"object\": { \"object\": \"checkout.session\" } }\n}"
            },
            "url": "{{baseUrl}}/api/payments/webhook"
          }
        },
        {
          "name": "Invalid Signature",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invalid signature rejected', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Stripe-Signature", "value": "invalid" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"evt_invalid_signature\",\n  \"object\": \"event\",\n  \"type\": \"checkout.session.completed\",\n  \"data\": { \"object\": {} }\n}"
            },
            "url": "{{baseUrl}}/api/payments/webhook"
          }
        },
        {
          "name": "Duplicate Webhook (Stripe CLI)",
          "description": "Resend the same Stripe event ID using stripe events resend. Database idempotency prevents duplicate booking transitions.",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Stripe-Signature", "value": "{{stripeSignature}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"evt_test_replace_with_same_cli_event_id\",\n  \"object\": \"event\",\n  \"type\": \"checkout.session.completed\",\n  \"data\": { \"object\": { \"object\": \"checkout.session\" } }\n}"
            },
            "url": "{{baseUrl}}/api/payments/webhook"
          }
        }
      ]
    }
  ]
}
